{
  "manifest_version": 3,
  "name": "Search Tabs - Google Sheets",
  "version": "2.5",
  "description": "This tool helps you quickly find and manage tabs in Google Sheets.",
  "host_permissions": ["https://docs.google.com/spreadsheets/*"],
  "icons": {
    "16": "icons/spreadsheet16.png",
    "32": "icons/spreadsheet32.png",
    "48": "icons/spreadsheet48.png",
    "128": "icons/spreadsheet128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/spreadsheet16.png",
      "32": "icons/spreadsheet32.png",
      "48": "icons/spreadsheet48.png",
      "128": "icons/spreadsheet128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": [
        "src/utils/constants.js",
        "src/utils/helpers.js",
        "src/utils/search.js",
        "src/content/storage.js",
        "content.js"
      ],
      "css": [
        "src/styles/popup.css",
        "src/styles/button.css"
      ]
    }
  ]
}